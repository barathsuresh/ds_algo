# MANIFEST.in - Package distribution manifest
# Specifies additional files to include in the package distribution

include README.md
include LICENSE
include requirements.txt
include setup.py
include .gitignore

# Include all README files
recursive-include ds_algo *.md

# Include all Python files
recursive-include ds_algo *.py

# Include any documentation
recursive-include docs *
prune docs/_build

# Include any test files
recursive-include tests *.py

# Include any example notebooks
include *.ipynb
recursive-include examples *.ipynb

# Exclude compiled files and caches
global-exclude __pycache__
global-exclude *.py[co]
global-exclude *.so
global-exclude .DS_Store
global-exclude *.swp
global-exclude *.swo